<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_back"
                app:tint="@color/ink" />
            <TextView
                android:id="@+id/pageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="添加客户"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="请完整填写客户资料后保存"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <!-- 姓名 -->
        <TextView
            style="@style/Form.Label"
            android:text="姓名" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="4dp"
            app:boxCornerRadiusBottomStart="4dp"
            app:boxCornerRadiusTopEnd="4dp"
            app:boxCornerRadiusTopStart="4dp"
            app:boxStrokeColor="@color/pine"
            app:boxStrokeWidth="1dp"
            app:startIconDrawable="@drawable/ic_form_person"
            app:startIconTint="@color/ink_soft">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入姓名"
                android:inputType="textPersonName"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 手机 -->
        <TextView
            style="@style/Form.Label"
            android:layout_marginTop="14dp"
            android:text="手机" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="4dp"
            app:boxCornerRadiusBottomStart="4dp"
            app:boxCornerRadiusTopEnd="4dp"
            app:boxCornerRadiusTopStart="4dp"
            app:boxStrokeColor="@color/pine"
            app:boxStrokeWidth="1dp"
            app:startIconDrawable="@drawable/ic_form_phone"
            app:startIconTint="@color/ink_soft">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入手机号"
                android:inputType="phone"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 性别 -->
        <TextView
            style="@style/Form.Label"
            android:layout_marginTop="14dp"
            android:text="性别" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_form_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_form_gender" />
            <RadioGroup
                android:id="@+id/inputGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/genderMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/pine"
                    android:minWidth="0dp"
                    android:text="男"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/genderFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:buttonTint="@color/pine"
                    android:minWidth="0dp"
                    android:text="女"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 生日 -->
        <TextView
            style="@style/Form.Label"
            android:layout_marginTop="14dp"
            android:text="生日" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_form_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_form_date" />
            <TextView
                android:id="@+id/inputBirthday"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:hint="点击选择日期"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_soft"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 备注 -->
        <TextView
            style="@style/Form.Label"
            android:layout_marginTop="14dp"
            android:text="备注" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="4dp"
            app:boxCornerRadiusBottomStart="4dp"
            app:boxCornerRadiusTopEnd="4dp"
            app:boxCornerRadiusTopStart="4dp"
            app:boxStrokeColor="@color/pine"
            app:boxStrokeWidth="1dp"
            app:startIconDrawable="@drawable/ic_form_note"
            app:startIconTint="@color/ink_soft">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="可选"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="取消"
                android:textColor="@color/ink"
                app:cornerRadius="4dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="保存"
                android:textColor="@color/paper2"
                app:backgroundTint="@color/pine"
                app:cornerRadius="4dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
